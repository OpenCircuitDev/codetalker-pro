    <!-- Permissions -->
    <string name="permission_camera_title">Camera access</string>
    <string name="permission_camera_body">codetalker uses the camera once — to scan the pairing QR from your desktop dashboard. The camera is not used after pairing.</string>
    <string name="permission_mic_title">Microphone access</string>
    <string name="permission_mic_body">codetalker uses the microphone only when you press the side button. Audio is streamed to your codetalker desktop and never recorded or stored.</string>
    <string name="permission_notifications_title">Notifications</string>
    <string name="permission_notifications_body">codetalker shows a foreground notification while audio is streaming, so Android keeps the connection alive when the screen is off.</string>
    <string name="permission_grant">Allow</string>
    <string name="permission_open_settings">Open settings</string>
    <string name="permission_skip">Skip for now</string>
    <string name="permission_denied_settings_hint">codetalker needs %s to work. Open the system settings to grant it.</string>

