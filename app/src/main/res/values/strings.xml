    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to codetalker companion</string>
    <string name="onboarding_welcome_body">Hands-free voice + AR for your local codetalker desktop. Three quick steps to get going.</string>
    <string name="onboarding_daemon_title">Start the codetalker desktop</string>
    <string name="onboarding_daemon_body">Run codetalker on your computer (open source — see the GitHub link in About) and open its dashboard.</string>
    <string name="onboarding_pair_title">Scan the pairing QR</string>
