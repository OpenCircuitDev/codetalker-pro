<?xml version="1.0" encoding="utf-8"?>
<!--
  CCT-32 Task C.4 — final UI copy.

  Every visible string lives here. Plurals use <plurals> for grammatical
  correctness; placeholders use positional %s/%d so translations are
  reorderable. End-user copy avoids dev shorthand ("daemon" → "the
  codetalker desktop", "SSE" → "live updates", etc.).
-->
