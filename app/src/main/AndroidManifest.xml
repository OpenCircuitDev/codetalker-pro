<?xml version="1.0" encoding="utf-8"?>
<!--
  CCT-31 — Codetalker AR Companion manifest.

  Permissions:
    - INTERNET: hits codetalker daemon over LAN/Tailscale
    - ACCESS_NETWORK_STATE: ConnectionGuard listens for WiFi/network changes
    - RECORD_AUDIO: STT input when user clicks side button
    - CAMERA: QR-scan for daemon pairing
    - FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PLAYBACK: keep audio
      stream alive when the app goes to background while wearing glasses
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Codetalker.Splash"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <!--
          CCT-32 Task C.1: adaptive launcher icon (cyan→violet orb with
          waveform glyph) lives in res/mipmap-anydpi-v26/. Monochrome
          variant covers Android 13+ themed icons. No PNG fallbacks
          needed — minSdk=31 (Android 12) always supports adaptive XML.
        -->

        <!--
          usesCleartextTraffic=true allows http:// to LAN IPs and Tailnet
          100.x.x.x addresses. Only LAN/VPN traffic flows over cleartext;
          public-internet calls would still need https. Restrict via
          network_security_config.xml in a later phase.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Codetalker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          CCT-31 Phase 10a — foreground service keeps the audio stream
          + buddy SSE alive when the user backgrounds the app or rotates
          the Beam Pro. media_playback type so Android 14 grants
          legitimate background-audio runtime.
        -->
        <service
            android:name=".service.CompanionForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          CCT-32 Task B.4 — opt-in start-on-boot receiver. Listens for
          BOOT_COMPLETED; only actually starts the foreground service if
          the user enabled "Start on device boot" in PreferencesScreen.
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
