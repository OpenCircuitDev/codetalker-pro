<?xml version="1.0" encoding="utf-8"?>
<!--
  CCT-31 / CCT-32 — codetalker companion manifest.

  Permission rationales (Phase F.3): every dangerous permission ships
  with an inline comment that pairs to the corresponding section in
  docs/PRIVACY-POLICY.md §3 and the listing-page disclosure in
  store-assets/google-play/listing.md and store-assets/xreal-store/listing.md.

  Privacy-policy URL is exposed via the in-app About screen (deep-link to
  the published markdown). The Data Safety Form responses live in
  store-assets/google-play/data-safety-form.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reach the codetalker desktop daemon over LAN / Tailnet. No remote
         servers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Push-to-talk speech capture during the side-button gesture. Audio
         is streamed to the paired daemon and never stored. PRIVACY-POLICY §2.2 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- One-time QR pairing only. Camera is not used after pairing. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Keep TTS audio alive while screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Show the foreground-service status notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional opt-in: re-launch service after device boot. Wired only
         if the user enables 'Start on device boot' in Preferences. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Codetalker.Splash"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <!--
          CCT-32 Task C.1: adaptive launcher icon (cyan→violet orb with
          waveform glyph) lives in res/mipmap-anydpi-v26/. Monochrome
          variant covers Android 13+ themed icons. No PNG fallbacks
          needed — minSdk=31 (Android 12) always supports adaptive XML.
        -->

        <!--
          CCT-32 Task G.1 — disable Sentry's auto-init ContentProvider.
          Sentry installs a ContentProvider that calls SentryAndroid.init
          BEFORE the application's onCreate; with no DSN configured at
          build time it throws IllegalArgumentException and crashes the
          app on launch. CrashReporter.init() is the single source of
          truth for SDK initialization, gated by user consent + DSN
          presence (PRIVACY-POLICY.md §4 invariant).
        -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!--
          CCT-32 Task F.3: privacy-policy + ToS deep-links exposed to
          installers / app-info screens. Google Play scanner picks up the
          PRIVACY_POLICY_URL meta-data automatically.
        -->
        <meta-data
            android:name="dev.opencircuit.codetalker.PRIVACY_POLICY_URL"
            android:value="https://github.com/OpenCircuitDev/codetalker-pro/blob/main/companion-android/docs/PRIVACY-POLICY.md" />
        <meta-data
            android:name="dev.opencircuit.codetalker.TERMS_URL"
            android:value="https://github.com/OpenCircuitDev/codetalker-pro/blob/main/companion-android/docs/TERMS.md" />

        <!--
          CCT-32 Task F.3 — permission rationales referenced at runtime
          by ui/permissions/PermissionRationaleScreen. Keeping them as
          meta-data lets the listing scanner cross-reference manifest
          entries against the strings the user sees.
        -->
        <meta-data
            android:name="dev.opencircuit.codetalker.RATIONALE_RECORD_AUDIO"
            android:value="@string/permission_mic_body" />
        <meta-data
            android:name="dev.opencircuit.codetalker.RATIONALE_CAMERA"
            android:value="@string/permission_camera_body" />
        <meta-data
            android:name="dev.opencircuit.codetalker.RATIONALE_POST_NOTIFICATIONS"
            android:value="@string/permission_notifications_body" />

        <!--
          usesCleartextTraffic=true allows http:// to LAN IPs and Tailnet
          100.x.x.x addresses. Only LAN/VPN traffic flows over cleartext;
          public-internet calls would still need https. Restrict via
          network_security_config.xml in a later phase.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Codetalker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          CCT-31 Phase 10a — foreground service keeps the audio stream
          + buddy SSE alive when the user backgrounds the app or rotates
          the Beam Pro. media_playback type so Android 14 grants
          legitimate background-audio runtime.
        -->
        <service
            android:name=".service.CompanionForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          CCT-32 Task B.4 — opt-in start-on-boot receiver. Listens for
          BOOT_COMPLETED; only actually starts the foreground service if
          the user enabled "Start on device boot" in PreferencesScreen.
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
