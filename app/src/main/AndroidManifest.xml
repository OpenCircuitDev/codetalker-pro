<?xml version="1.0" encoding="utf-8"?>
<!--
  CCT-31 — Codetalker AR Companion manifest.

  Permissions:
    - INTERNET: hits codetalker daemon over LAN/Tailscale
    - ACCESS_NETWORK_STATE: ConnectionGuard listens for WiFi/network changes
    - RECORD_AUDIO: STT input when user clicks side button
    - CAMERA: QR-scan for daemon pairing
    - FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PLAYBACK: keep audio
      stream alive when the app goes to background while wearing glasses
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Codetalker"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <!--
          Launcher icons (mipmap/ic_launcher, mipmap/ic_launcher_round) will
          land in Phase 10 (polish + branding). Until then, Android falls back
          to the default system icon, which is fine for development builds.
        -->

        <!--
          usesCleartextTraffic=true allows http:// to LAN IPs and Tailnet
          100.x.x.x addresses. Only LAN/VPN traffic flows over cleartext;
          public-internet calls would still need https. Restrict via
          network_security_config.xml in a later phase.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Codetalker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          CCT-31 Phase 10a — foreground service keeps the audio stream
          + buddy SSE alive when the user backgrounds the app or rotates
          the Beam Pro. media_playback type so Android 14 grants
          legitimate background-audio runtime.
        -->
        <service
            android:name=".service.CompanionForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
